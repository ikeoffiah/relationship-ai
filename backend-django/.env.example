# Database (Supabase for prod, local postgres for dev)
DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Redis (Upstash for prod, local redis for dev)
REDIS_URL=redis://localhost:6379/0

# Vector DB (pgvector via Supabase — same DATABASE_URL)
# No separate vector DB service needed for MVP

# LLM
ANTHROPIC_API_KEY=sk-ant-...

# Encryption (single master secret — replaces AWS KMS for MVP)
# 32-byte hex secret, generated once, stored in Railway env
ENCRYPTION_MASTER_SECRET=

# Chat media (photos and voice notes). Blobs are encrypted with
# ENCRYPTION_MASTER_SECRET before upload, so Cloudinary only ever holds
# ciphertext. Leave unset in dev: storage falls back to in-memory, which works
# but does not survive a restart.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# App
SECRET_KEY=
DEBUG=false
ALLOWED_HOSTS=your-service.up.railway.app

# Monitoring
SENTRY_DSN=
