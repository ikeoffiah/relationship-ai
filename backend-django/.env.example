# Environment for backend-django (web, celery worker, celery beat).
#
# Copy to .env.local, which is gitignored and is the file settings.py actually
# reads. Every variable below is read somewhere in this service — if you add a
# new env() call, add it here too, or the next person deploying has no way to
# know it exists.
#
# backend-fastapi has its own .env.example and .env.local. Variables that only
# it reads (LLM_PROVIDER, ANTHROPIC_API_KEY, INTERNAL_API_TOKEN) belong there,
# not here.

# ── Data stores ─────────────────────────────────────────────────────────────
# Defaults to sqlite:///db.sqlite3 when unset. Use the docker-compose hostname
# (postgres/redis) when running in compose, localhost when running on the host.
DATABASE_URL=postgresql://postgres:localdevonly@postgres:5432/postgres
REDIS_URL=redis://redis:6379/0

# ── App ─────────────────────────────────────────────────────────────────────
SECRET_KEY=
DEBUG=false
ALLOWED_HOSTS=your-service.up.railway.app
# Both default from DEBUG; override only to test HTTPS behaviour locally.
# FORCE_HTTPS=true
# HSTS_SECONDS=31536000

# ── Encryption ──────────────────────────────────────────────────────────────
# 32-byte hex secret, generated once. Message bodies, voice transcripts and
# chat media blobs are all encrypted under keys derived from this — losing it
# means losing every thread, and rotating it means re-encrypting them.
ENCRYPTION_MASTER_SECRET=

# ── LLM ─────────────────────────────────────────────────────────────────────
# Bliss's in-thread coaching (apps/chat/assist.py) and embeddings.
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
# Model for the send-time checks, which run on a 2.5s budget.
OPENAI_FAST_MODEL=gpt-4.1-nano

# ── Chat media (Cloudinary) ─────────────────────────────────────────────────
# Photos and voice notes. Cloudinary stores ciphertext only — blobs are
# encrypted with ENCRYPTION_MASTER_SECRET before upload and decrypted by Django
# on the way out, so these credentials alone cannot read a single message.
# Leave unset in dev: storage falls back to in-memory, which works but does not
# survive a restart.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── LiveKit (video for joint sessions) ──────────────────────────────────────
# Tokens are minted server-side. The endpoint returns 503 until these are set.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=wss://your-project.livekit.cloud

# ── Email (Resend) ──────────────────────────────────────────────────────────
EMAIL_HOST=smtp.resend.com
EMAIL_PORT=587
EMAIL_HOST_USER=resend
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=onboarding@resend.dev

# ── Auth and push ───────────────────────────────────────────────────────────
GOOGLE_OAUTH_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# Base64 of the Firebase service-account JSON, for push notifications.
FIREBASE_SERVICE_ACCOUNT_JSON=

# ── Monitoring ──────────────────────────────────────────────────────────────
SENTRY_DSN=
