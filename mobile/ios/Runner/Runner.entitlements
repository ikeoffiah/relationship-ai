<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- APNs environment for push notifications.
	     "development" is correct for debug builds on a real device (flutter run).
	     Switch to "production" (or add a Release-specific entitlements file) for
	     TestFlight / App Store builds. -->
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
